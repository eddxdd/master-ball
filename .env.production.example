# Copy to the EC2 host as `/home/ec2-user/apps/master-ball/.env`
# (never commit the real file). See Docs/cursor/remote.md.

APP_NAME=Master Ball

POSTGRES_USER=masterball
POSTGRES_PASSWORD=replace-me-strong-password
POSTGRES_DB=masterball

NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me-strong-password

JWT_SECRET_KEY=replace-me-long-random-secret

# Professor chat (required for /chat — otherwise 503)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# JSON list — must match the public site origin
CORS_ORIGINS=["https://masterball.eduardolemos.com"]

LLM_FALLBACK_ENABLED=true
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=masterball

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=

MCP_API_KEY=
GOOGLE_API_KEY=

# Optional: pin images to a git SHA after a bad latest tag
# IMAGE_TAG=latest
# ECR_REGISTRY=338753559735.dkr.ecr.us-east-2.amazonaws.com
