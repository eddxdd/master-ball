node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Generated at deploy time, requires the real production domain — see
# Backend/scripts/generate_sitemap.py and Docs/frontend/README.md's SEO section ---
Frontend/public/sitemap.xml

# --- Docker ---
docker-compose.override.yml

# --- Capacitor / native (kept out unless the mobile stretch goal is picked up) ---
android/
ios/

# --- Logs ---
*.log
logs/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/

# --- Local-only / not part of the deployable app ---
portfolio-images/
rename-folder-to-master-ball.ps1

# --- Misc build artifacts ---
*.tsbuildinfo
.turbo/

# --- Playwright (Phase 7 E2E suite — see Frontend/e2e/, not CI-gated) ---
Frontend/test-results/
Frontend/playwright-report/
Frontend/blob-report/
Frontend/playwright/.cache/

# --- Personal exports (one-off docs snapshots for offline/mobile reading —
# not part of the app or its docs) ---
/exports/
