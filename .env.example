# Copy to .env at the repo root before running `docker compose up`.
# These are compose-level vars, consumed by docker-compose.yml and passed
# through to the backend/frontend containers — see Docs/setup.md.

APP_NAME=Master Ball
ENVIRONMENT=local
RELEASE=

POSTGRES_USER=masterball
POSTGRES_PASSWORD=masterball
POSTGRES_DB=masterball

# --- AI / observability (optional; features degrade cleanly when unset) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_FALLBACK_ENABLED=true

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=masterball

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=coach@example.com

MCP_API_KEY=
JWT_SECRET_KEY=masterball-dev-secret-change-me-please
