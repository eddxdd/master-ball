# Copy to .env at the repo root before running `docker compose up`.
# These are compose-level vars, consumed by docker-compose.yml and passed
# through to the backend/frontend containers — see Docs/setup.md.

# Display name shown in the UI/API docs title — see Docs/README.md's
# "Naming & branding" section for how this flows through the codebase.
APP_NAME=DexTrAIner

# Postgres (used to build the backend's DATABASE_URL inside docker-compose.yml)
POSTGRES_USER=dextrainer
POSTGRES_PASSWORD=dextrainer
POSTGRES_DB=dextrainer
