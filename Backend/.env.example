# Copy to .env for local (non-Docker) runs. When running via `docker compose up`
# at the repo root, these are supplied by the root .env / docker-compose.yml instead.

APP_NAME=DexTrAIner
ENVIRONMENT=local

DATABASE_URL=postgresql+asyncpg://dextrainer:dextrainer@localhost:5432/dextrainer
VALKEY_URL=redis://localhost:6379/0

# JSON array, since pydantic-settings parses list-typed fields as JSON by default.
CORS_ORIGINS=["http://localhost:5173"]
