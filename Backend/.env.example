# Copy to .env for local (non-Docker) runs. When running via `docker compose up`
# at the repo root, these are supplied by the root .env / docker-compose.yml instead.

APP_NAME=Master Ball
ENVIRONMENT=local
RELEASE=

# Port 5433, not 5432 — see docker-compose.yml's postgres service comment
# (avoids a silent conflict with a native Postgres install on the host).
DATABASE_URL=postgresql+asyncpg://masterball:masterball@localhost:5433/masterball
VALKEY_URL=redis://localhost:6379/0

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=masterball-graph

CORS_ORIGINS=["http://localhost:5173"]

# --- AI agent ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LLM_FALLBACK_ENABLED=true
LLM_ROUTER_TIMEOUT_S=30
LLM_SYNTHESIZER_TIMEOUT_S=90
LLM_MAX_RETRIES=2

# LangSmith — outside ENVIRONMENT=local, tracing auto-enables when the key is set.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=masterball

# Langfuse (optional — docker compose --profile observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3100

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=coach@example.com

MCP_API_KEY=

JWT_SECRET_KEY=masterball-dev-secret-change-me-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
